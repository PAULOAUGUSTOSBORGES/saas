rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAutenticado() {
      return request.auth != null;
    }

    function isMaster() {
      return isAutenticado() && (
        request.auth.token.email == 'pauloaugusto.silvaborges@gmail.com' ||
        request.auth.token.email == 'fabricadecoresgoiania@gmail.com'
      );
    }

    // Acesso irrestrito para os fundadores do SaaS (inclui write em tudo)
    match /{document=**} {
      allow read, write: if isMaster();
    }

    // Consulta de licenca e auto-cadastro de trial por sistemas clientes (FC-Gestao, FC-Food, etc.)
    match /empresas/{empresaId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'TRIAL' || request.resource.data.status == 'PENDENTE_PAGAMENTO';
      allow update, delete: if isMaster();

      // Subcolecoes de controle financeiro (ex: faturas_saas)
      match /{allChildren=**} {
        allow read, write: if isMaster();
      }
    }

    // Consulta de catalogo de planos e softwares — leitura publica, escrita somente master
    match /planos/{planoId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /planos_saas/{planoId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /sistemas/{sistemaId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /sistemas_saas/{sistemaId} {
      allow read: if true;
      allow write: if isMaster();
    }
  }
}
